#!/usr/bin/env python3
"""
termpeek-worker: High-performance asynchronous query and scoring worker for termpeek.
Communicates with Zsh via non-blocking pipes/FIFOs.
"""

import os
import sys
import time
import math
import signal
import sqlite3
import re
import json

CURATED_RECIPES = [
    "tar -czvf archive.tar.gz <folder>",
    "tar -xzvf archive.tar.gz",
    "rsync -avz --progress <src>/ <dest>/",
    "ffmpeg -i input.mp4 -c:v libx264 -crf 23 output.mp4",
    "ffmpeg -i input.mp4 -vn -c:a copy output.aac",
    "find . -type f -name '*.log' -delete",
    "find . -type f -size +100M",
    "docker stop $(docker ps -aq)",
    "docker system prune -a --volumes",
    "git log --oneline --graph --decorate --all",
    "git commit --amend --no-edit",
    "git reset --soft HEAD~1",
    "curl -fsSL <url> | bash",
    "chmod +x <file>",
    "python3 -m http.server 8000",
    "lsof -i :8000",
    "kill -9 $(lsof -t -i :8000)",
    "grep -rnw . -e 'pattern'",
    "ssh -i ~/.ssh/key.pem user@host",
    "du -sh * | sort -hr",
]

SECRET_PATTERNS = [
    (re.compile(r"(sk-[a-zA-Z0-9_\-]{4})[a-zA-Z0-9_\-]+"), r"\1****[REDACTED]"),
    (re.compile(r"(gh[po]_[a-zA-Z0-9]{4})[a-zA-Z0-9]+"), r"\1****[REDACTED]"),
    (re.compile(r"(Bearer )[a-zA-Z0-9_\.\-]{8,}"), r"\1****[REDACTED]"),
    (re.compile(r"(AKIA[0-9A-Z]{4})[0-9A-Z]+"), r"\1****[REDACTED]"),
    (re.compile(r"((?:password|token|secret)=)[^\s&\"'`]+"), r"\1****[REDACTED]"),
]

SECRET_CHECK = re.compile(r"(sk-|ghp_|gho_|github_pat_|Bearer|AKIA|password=|token=|secret=)")

DANGEROUS_PATTERNS = [
    re.compile(r"^rm\s+.*-[a-zA-Z0-9]*r"),
    re.compile(r"^rm\s+.*--recursive"),
    re.compile(r"^rm\s+.*-[a-zA-Z0-9]*f"),
    re.compile(r"^git\s+reset\s+--hard"),
    re.compile(r"^git\s+clean\s+.*-[a-zA-Z0-9]*f"),
    re.compile(r"^git\s+branch\s+-D"),
    re.compile(r"^git\s+push\s+.*--force"),
    re.compile(r"^git\s+push\s+.*-f(\s|$)"),
    re.compile(r"^git\s+push\s+.*\+.*:"),
    re.compile(r"^git\s+checkout\s+--\s+\."),
    re.compile(r"^git\s+restore\s+\."),
    re.compile(r"^kubectl\s+delete"),
    re.compile(r"^helm\s+uninstall"),
    re.compile(r"^docker\s+system\s+prune"),
    re.compile(r"^docker\s+rm\s+.*-[a-zA-Z0-9]*f"),
    re.compile(r"(drop\s+database|drop\s+table)", re.IGNORECASE),
    re.compile(r"^(mkfs|dd\s+if=)"),
    re.compile(r"^(killall\s+|kill\s+-9\s+-1)"),
    re.compile(r"^chmod\s+.*-R\s+777"),
]

DANGEROUS_COMBINED = re.compile(
    r"^rm\s+.*-[a-zA-Z0-9]*[rf]|^rm\s+.*--recursive|^git\s+reset\s+--hard|"
    r"^git\s+clean\s+.*-[a-zA-Z0-9]*f|^git\s+branch\s+-D|^git\s+push\s+.*(?:--force|-f(\s|$))|"
    r"^git\s+push\s+.*\+.*:|^git\s+checkout\s+--\s+\.|^git\s+restore\s+\.|"
    r"^kubectl\s+delete|^helm\s+uninstall|^docker\s+system\s+prune|^docker\s+rm\s+.*-[a-zA-Z0-9]*f|"
    r"(?:drop\s+database|drop\s+table)|^(?:mkfs|dd\s+if=)|^(?:killall\s+|kill\s+-9\s+-1)|^chmod\s+.*-R\s+777",
    re.IGNORECASE
)


class QueryWorker:
    def __init__(self):
        self.db_path = os.path.expanduser("~/.local/share/atuin/history.db")
        self.zsh_history_path = os.path.expanduser("~/.zsh_history")
        self.conn = None
        self._init_db()

        self.project_cache_dir = None
        self.project_tasks = []
        self.git_root_cache = {}
        self.meta_cache = {}
        self.query_cache = {}
        self.history_cache = []
        self.cmd_stats = {}
        self.indexed_stats = []
        self.transitions = {}
        self.transition_totals = {}
        self.last_history_refresh = 0.0

        # Config flags (overridden by environment)
        self.max_results = int(os.environ.get("TERMPEEK_MAX_RESULTS", "4"))
        self.only_successful = int(os.environ.get("TERMPEEK_ONLY_SUCCESSFUL", "1"))
        self.recipes_enabled = int(os.environ.get("TERMPEEK_RECIPES", "1"))
        self.project_tasks_enabled = int(os.environ.get("TERMPEEK_PROJECT_TASKS", "1"))
        self.safety_guard_enabled = int(os.environ.get("TERMPEEK_SAFETY_GUARD", "1"))
        self.mask_secrets_enabled = int(os.environ.get("TERMPEEK_MASK_SECRETS", "1"))

        self._refresh_history_cache()

    def _init_db(self):
        if os.path.isfile(self.db_path):
            try:
                uri = f"file:{self.db_path}?mode=ro"
                self.conn = sqlite3.connect(uri, uri=True, check_same_thread=False)
                self.conn.execute("PRAGMA query_only = ON;")
                self.conn.execute("PRAGMA mmap_size = 268435456;")
                self.conn.execute("PRAGMA temp_store = MEMORY;")
                self.conn.execute("PRAGMA cache_size = -64000;")
                cur = self.conn.cursor()
                cur.execute("SELECT command FROM history LIMIT 1;")
                cur.fetchall()
            except Exception:
                self.conn = None

    def _load_native_history(self):
        candidates = []
        hist_env = os.environ.get("HISTFILE")
        if hist_env and os.path.isfile(hist_env):
            candidates.append(hist_env)

        home = os.path.expanduser("~")
        for name in (".zsh_history", ".history", ".bash_history"):
            p = os.path.join(home, name)
            if os.path.isfile(p):
                candidates.append(p)

        if not candidates:
            return []

        raw_bytes = None
        for path in candidates:
            try:
                with open(path, "rb") as f:
                    raw_bytes = f.read()
                if raw_bytes:
                    break
            except Exception:
                continue

        if not raw_bytes:
            return []

        # Unmetafy Zsh history encoding if applicable
        res = bytearray()
        i = 0
        n = len(raw_bytes)
        while i < n:
            b = raw_bytes[i]
            if b == 0x83 and i + 1 < n:
                i += 1
                res.append(raw_bytes[i] ^ 0x20)
            else:
                res.append(b)
            i += 1

        text = res.decode("utf-8", errors="replace")
        lines = text.splitlines()
        ext_re = re.compile(r"^:\s*(\d+):(?:\d+);(.*)$")

        entries = []
        current_ts = 0
        current_cmd = []

        for line in lines:
            m = ext_re.match(line)
            if m:
                if current_cmd:
                    full_cmd = "\n".join(current_cmd).strip()
                    if full_cmd:
                        entries.append((full_cmd, full_cmd.lower(), "", current_ts))
                current_ts = int(m.group(1))
                current_cmd = [m.group(2)]
            else:
                if current_cmd:
                    current_cmd.append(line)
                else:
                    line_s = line.strip()
                    if line_s:
                        entries.append((line_s, line_s.lower(), "", 0))

        if current_cmd:
            full_cmd = "\n".join(current_cmd).strip()
            if full_cmd:
                entries.append((full_cmd, full_cmd.lower(), "", current_ts))

        # Reverse so most recent commands are first
        entries.reverse()
        return entries[:8000]

    def ingest_entries(self, entries):
        """Build deduplicated frecency index and first-order Markov transition graph from history entries."""
        self.history_cache = entries
        self.cmd_stats = {}
        self.transitions = {}
        self.transition_totals = {}
        self.query_cache.clear()

        now = time.time()
        total = len(entries)
        prev_clean = None
        prev_ts = 0.0

        # Iterate chronologically (oldest to newest) to build accurate Markov transitions
        for rev_idx in range(total - 1, -1, -1):
            raw_cmd, _, cwd, raw_ts = entries[rev_idx]
            clean = raw_cmd.replace("\r", "").replace("\n", " && ").strip()
            if len(clean) < 2:
                continue

            if raw_ts and raw_ts > 1e12:
                ts_sec = float(raw_ts) / 1e9
            elif raw_ts and raw_ts > 0:
                ts_sec = float(raw_ts)
            else:
                ts_sec = now - (rev_idx + 1) * 60.0

            age = max(0.0, now - ts_sec)
            decay = math.pow(0.5, age / 259200.0)

            stat = self.cmd_stats.get(clean)
            if stat is None:
                stat = {
                    "cmd": clean,
                    "lower": clean.lower(),
                    "count": 0,
                    "frecency": 0.0,
                    "last_ts": ts_sec,
                    "cwd_counts": {},
                }
                self.cmd_stats[clean] = stat

            stat["count"] += 1
            stat["frecency"] += max(0.05, decay)
            if ts_sec >= stat["last_ts"]:
                stat["last_ts"] = ts_sec
            if cwd:
                stat["cwd_counts"][cwd] = stat["cwd_counts"].get(cwd, 0) + 1

            # Record first-order Markov transition if within a 15-minute session window
            if prev_clean and prev_clean != clean:
                if (ts_sec - prev_ts) <= 900.0 or raw_ts == 0:
                    t_map = self.transitions.get(prev_clean)
                    if t_map is None:
                        t_map = {}
                        self.transitions[prev_clean] = t_map
                    t_map[clean] = t_map.get(clean, 0) + 1
                    self.transition_totals[prev_clean] = self.transition_totals.get(prev_clean, 0) + 1

            prev_clean = clean
            prev_ts = ts_sec

        for st in self.cmd_stats.values():
            age = max(0.0, now - st["last_ts"])
            st["base_score"] = (
                18.0 * math.log2(1.0 + st["frecency"])
                + 6.0 * math.log2(1.0 + st["count"])
                + 16.0 * math.pow(0.5, age / 86400.0)
                + (st["last_ts"] * 1e-12)
            )

        self.indexed_stats = sorted(
            self.cmd_stats.values(),
            key=lambda s: s["base_score"],
            reverse=True,
        )

    def record_command(self, cwd, prev_cmd, raw_cmd, ts=None):
        """Incrementally ingest a newly executed command in <0.05ms."""
        clean = raw_cmd.replace("\r", "").replace("\n", " && ").strip()
        if len(clean) < 2:
            return
        now = float(ts) if ts is not None else time.time()
        if now > 1e12:
            now /= 1e9

        stat = self.cmd_stats.get(clean)
        if stat is None:
            stat = {
                "cmd": clean,
                "lower": clean.lower(),
                "count": 0,
                "frecency": 0.0,
                "last_ts": now,
                "cwd_counts": {},
                "base_score": 0.0,
            }
            self.cmd_stats[clean] = stat
            self.indexed_stats.insert(0, stat)

        stat["count"] += 1
        stat["frecency"] += 1.0
        if now >= stat["last_ts"]:
            stat["last_ts"] = now
        if cwd:
            stat["cwd_counts"][cwd] = stat["cwd_counts"].get(cwd, 0) + 1
        stat["base_score"] = (
            18.0 * math.log2(1.0 + stat["frecency"])
            + 6.0 * math.log2(1.0 + stat["count"])
            + 16.0
            + (stat["last_ts"] * 1e-12)
        )

        if prev_cmd:
            prev_clean = prev_cmd.replace("\r", "").replace("\n", " && ").strip()
            if prev_clean and prev_clean != clean:
                t_map = self.transitions.get(prev_clean)
                if t_map is None:
                    t_map = {}
                    self.transitions[prev_clean] = t_map
                t_map[clean] = t_map.get(clean, 0) + 1
                self.transition_totals[prev_clean] = self.transition_totals.get(prev_clean, 0) + 1

        self.query_cache.clear()

    def _refresh_history_cache(self):
        now = time.time()
        if self.cmd_stats and (now - self.last_history_refresh < 30.0):
            return
        self.last_history_refresh = now

        # Strategy 1: Atuin SQLite database (if installed)
        if self.conn:
            try:
                exit_clause = "AND exit <= 0" if self.only_successful else ""
                sql = f"""
                    SELECT command, cwd, timestamp
                    FROM history
                    WHERE deleted_at IS NULL {exit_clause}
                    ORDER BY timestamp DESC
                    LIMIT 8000;
                """
                cur = self.conn.cursor()
                cur.execute(sql)
                rows = cur.fetchall()
                if rows:
                    entries = [(cmd, cmd.lower(), cwd, ts) for cmd, cwd, ts in rows]
                    self.ingest_entries(entries)
                    return
            except Exception:
                pass

        # Strategy 2: Universal fallback to native Zsh/Bash history file
        native_entries = self._load_native_history()
        if native_entries:
            self.ingest_entries(native_entries)

    def get_git_root(self, cwd):
        if cwd in self.git_root_cache:
            return self.git_root_cache[cwd]

        curr = cwd
        while curr and curr != "/":
            if os.path.isdir(os.path.join(curr, ".git")):
                self.git_root_cache[cwd] = curr
                return curr
            parent = os.path.dirname(curr)
            if parent == curr:
                break
            curr = parent
        self.git_root_cache[cwd] = ""
        return ""

    def load_project_tasks(self, cwd):
        if not self.project_tasks_enabled:
            self.project_tasks = []
            return

        if self.project_cache_dir == cwd:
            return

        self.project_cache_dir = cwd
        tasks = []

        # package.json
        pkg_json = os.path.join(cwd, "package.json")
        if os.path.isfile(pkg_json):
            try:
                with open(pkg_json, "r", encoding="utf-8", errors="ignore") as f:
                    data = json.load(f)
                    scripts = data.get("scripts", {})
                    runner = "npm"
                    if os.path.isfile(os.path.join(cwd, "pnpm-lock.yaml")):
                        runner = "pnpm"
                    elif os.path.isfile(os.path.join(cwd, "yarn.lock")):
                        runner = "yarn"
                    elif os.path.isfile(os.path.join(cwd, "bun.lockb")) or os.path.isfile(os.path.join(cwd, "bun.lock")):
                        runner = "bun"

                    for name in scripts:
                        if runner == "npm" and name in ("test", "start"):
                            tasks.append(f"npm {name}")
                        else:
                            tasks.append(f"{runner} run {name}")
            except Exception:
                pass

        # Makefile
        for make_name in ("Makefile", "makefile"):
            make_path = os.path.join(cwd, make_name)
            if os.path.isfile(make_path):
                try:
                    with open(make_path, "r", encoding="utf-8", errors="ignore") as f:
                        for line in f:
                            m = re.match(r"^([a-zA-Z0-9_\-]+):", line)
                            if m:
                                target = m.group(1)
                                if target not in (".PHONY", "all"):
                                    tasks.append(f"make {target}")
                except Exception:
                    pass
                break

        # Cargo.toml
        if os.path.isfile(os.path.join(cwd, "Cargo.toml")):
            tasks.extend(["cargo build", "cargo test", "cargo run", "cargo check"])

        # Docker compose
        if os.path.isfile(os.path.join(cwd, "docker-compose.yml")) or os.path.isfile(os.path.join(cwd, "compose.yaml")):
            tasks.extend(["docker compose up", "docker compose down", "docker compose ps"])

        # Python
        if any(os.path.isfile(os.path.join(cwd, x)) for x in ("pyproject.toml", "Pipfile", "requirements.txt")):
            tasks.extend(["pytest", "ruff check ."])

        self.project_tasks = tasks

    def is_dangerous(self, cmd):
        if not self.safety_guard_enabled:
            return False
        return bool(DANGEROUS_COMBINED.search(cmd))

    def check_and_mask_secret(self, cmd):
        if not self.mask_secrets_enabled:
            return False, cmd
        if not SECRET_CHECK.search(cmd):
            return False, cmd

        is_secret = False
        masked = cmd
        for pat, repl in SECRET_PATTERNS:
            new_val = pat.sub(repl, masked)
            if new_val != masked:
                is_secret = True
                masked = new_val
        return is_secret, masked

    @staticmethod
    def _match_quality(lower_trim, query_tokens, cmd_lower):
        if not query_tokens:
            return 0.0
        first_tok = query_tokens[0]
        if first_tok not in cmd_lower:
            return 0.0

        # Tier 1: Exact command prefix match
        if cmd_lower.startswith(lower_trim):
            return 115.0 + 15.0 / (1.0 + 0.08 * (len(cmd_lower) - len(lower_trim)))

        # Tier 2: Contiguous substring match weighted by boundary context
        pos = cmd_lower.find(lower_trim)
        if pos >= 0:
            prefix_slice = cmd_lower[:pos].rstrip()
            if prefix_slice.endswith(("&&", ";", "|")):
                return 94.0
            prev_ch = cmd_lower[pos - 1]
            if prev_ch == " ":
                return 78.0
            if prev_ch in ("/", "-", "_", "=", ":"):
                return 64.0
            return 28.0

        # Tier 3: Ordered multi-token / word-boundary match (e.g. 'cd chess' -> 'cd workspace/chess')
        if len(query_tokens) > 1:
            search_from = 0
            boundary_hits = 0
            first_pos = -1
            for idx_t, tok in enumerate(query_tokens):
                p = cmd_lower.find(tok, search_from)
                if p < 0:
                    return 0.0
                if idx_t == 0:
                    first_pos = p
                if p == 0 or cmd_lower[p - 1] in (" ", "/", "-", "_", "=", ":", ";", "|", "&"):
                    boundary_hits += 1
                search_from = p + len(tok)

            score = 48.0 + 14.0 * (boundary_hits / len(query_tokens))
            if first_pos == 0:
                score += 18.0
            return score

        return 0.0

    def query(self, query_id, cwd, buffer_text, prev_cmd=""):
        trimmed = buffer_text.strip()
        if len(trimmed) < 2:
            return f"{query_id}\t0"

        prev_clean = prev_cmd.strip() if prev_cmd else ""
        cache_key = (cwd, trimmed, prev_clean)
        if cache_key in self.query_cache:
            return f"{query_id}\t{self.query_cache[cache_key]}"

        self.load_project_tasks(cwd)
        git_root = self.get_git_root(cwd)

        matches = []
        seen = set()

        def add_candidate(raw_cmd, tag=""):
            clean = raw_cmd.replace("\r", "").replace("\n", " && ").strip()
            if not clean or clean == trimmed or clean in seen:
                return False
            seen.add(clean)

            if clean in self.meta_cache:
                is_danger, display_str = self.meta_cache[clean]
            else:
                is_danger = 1 if self.is_dangerous(clean) else 0
                _, display_str = self.check_and_mask_secret(clean)
                if len(self.meta_cache) < 2048:
                    self.meta_cache[clean] = (is_danger, display_str)

            tags = []
            if tag:
                tags.append(tag)
            if is_danger:
                tags.append("[DANGER]")
            if display_str != clean:
                tags.append("[SECRET]")
            tag_str = " ".join(tags)
            matches.append((clean, tag_str, is_danger, display_str))
            return True

        lower_trim = trimmed.lower()
        query_tokens = lower_trim.replace("/", " ").split()
        if not query_tokens:
            query_tokens = [lower_trim]

        # Step 1: Project tasks
        for task in self.project_tasks:
            if self._match_quality(lower_trim, query_tokens, task.lower()) > 0.0:
                add_candidate(task, "[project]")
                if len(matches) >= self.max_results:
                    break

        # Step 2: History (Token-Aware + Exponential Frecency + CWD + Markov Transitions)
        self._refresh_history_cache()
        if len(matches) < self.max_results and self.indexed_stats:
            trans_map = self.transitions.get(prev_clean) if prev_clean else None
            trans_total = self.transition_totals.get(prev_clean, 0) if prev_clean else 0
            first_tok = query_tokens[0]

            scored_rows = []
            for stat in self.indexed_stats:
                cmd_lower = stat["lower"]
                if first_tok not in cmd_lower:
                    continue
                m_score = self._match_quality(lower_trim, query_tokens, cmd_lower)
                if m_score <= 0.0:
                    continue

                # Directory specificity boost
                cwd_score = 0.0
                cwd_map = stat["cwd_counts"]
                if cwd and cwd in cwd_map:
                    cwd_score = 65.0 + 12.0 * math.log2(1.0 + cwd_map[cwd])
                elif git_root and cwd_map:
                    for c_dir in cwd_map:
                        if c_dir.startswith(git_root):
                            cwd_score = 32.0
                            break

                # First-order Markov transition boost P(cmd_t | cmd_{t-1})
                markov_score = 0.0
                if trans_map and trans_total > 0:
                    t_cnt = trans_map.get(stat["cmd"], 0)
                    if t_cnt > 0:
                        markov_score = (
                            90.0 * (t_cnt / trans_total)
                            + 18.0 * math.log2(1.0 + t_cnt)
                        )

                total_score = m_score + cwd_score + stat["base_score"] + markov_score
                scored_rows.append((total_score, stat["cmd"]))

            scored_rows.sort(key=lambda x: x[0], reverse=True)
            for _, row_cmd in scored_rows:
                add_candidate(row_cmd)
                if len(matches) >= self.max_results:
                    break

        # Step 3: Recipes fallback
        if self.recipes_enabled and len(matches) < self.max_results:
            for recipe in CURATED_RECIPES:
                if self._match_quality(lower_trim, query_tokens, recipe.lower()) > 0.0:
                    add_candidate(recipe, "[recipe]")
                    if len(matches) >= self.max_results:
                        break

        # Build serialized response payload
        parts = [str(len(matches))]
        for clean, tag_str, is_danger, display_str in matches:
            parts.extend([clean, tag_str, str(is_danger), display_str])
        serialized_payload = "\t".join(parts)

        if len(self.query_cache) > 512:
            self.query_cache.clear()
        self.query_cache[cache_key] = serialized_payload

        return f"{query_id}\t{serialized_payload}"


def main():
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, lambda s, f: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda s, f: sys.exit(0))

    worker = QueryWorker()

    in_f = sys.stdin
    out_f = sys.stdout

    if len(sys.argv) >= 3:
        in_path = sys.argv[1]
        out_path = sys.argv[2]
        try:
            in_f = open(in_path, "r", encoding="utf-8", errors="ignore")
            out_f = open(out_path, "w", encoding="utf-8", errors="ignore")
        except Exception:
            sys.exit(1)

    while True:
        try:
            line = in_f.readline()
            if not line:
                break
            line = line.rstrip("\r\n")
            if line == "QUIT":
                break
            if not line:
                continue

            fields = line.split("\t")
            if fields[0] == "RECORD" and len(fields) >= 4:
                worker.record_command(fields[1], fields[2], fields[3])
                continue
            if len(fields) >= 3:
                qid, cwd, buf = fields[0], fields[1], fields[2]
                prev_cmd = fields[3] if len(fields) >= 4 else ""
                resp = worker.query(qid, cwd, buf, prev_cmd)
                out_f.write(resp + "\n")
                out_f.flush()
        except (BrokenPipeError, IOError):
            break
        except Exception:
            pass


if __name__ == "__main__":
    main()
